{
  "name": "ta — coding agent",
  "short_name": "ta",
  "description": "Coding agent chạy ngay trên thiết bị của bạn",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#0e0f11",
  "theme_color": "#0e0f11",
  "categories": ["developer", "productivity", "utilities"],
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any maskable" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" },
    { "src": "/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "share_target": {
    "action": "/",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        { "name": "files", "accept": ["image/*", "text/*", "application/pdf", "application/zip", "application/x-tar", ".zip", ".tar", ".json", ".md"] }
      ]
    }
  },
  "shortcuts": [
    { "name": "New task", "short_name": "New", "url": "/?new=1", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] }
  ]
}
